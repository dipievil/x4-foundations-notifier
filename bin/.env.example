# Copy to go_server/.env and fill in, or export the variables in your shell.
# The server reads the environment only; nothing here is loaded automatically.

# Bind address. 127.0.0.1 keeps it reachable only from this machine, which is
# what you want when X4 runs on the same PC.
X4_LISTEN=127.0.0.1:8080

# Shared secret. Set the same value as TOKEN in fleet_notifier/ui/notifier.lua.
# Leave empty to accept any request (not recommended).
X4_TOKEN=change-me

# ntfy (https://ntfy.sh or your own instance)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
