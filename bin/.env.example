# Copy to .env and fill in. The server reads .env from the folder it runs in,
# so double-clicking start-x4-notifier.bat uses the .env next to it. A variable
# exported in the shell still wins over the file.

# Bind address. 127.0.0.1 keeps it reachable only from this machine, which is
# what you want when X4 runs on the same PC. The port is unusual on purpose so
# it does not collide with web servers and dev tools on 8080.
X4_LISTEN=127.0.0.1:47100

# Shared secret. If you set a value here, set the exact same value in TOKEN
# (fleet_notifier/ui/notifier.lua) or the server rejects every event with 401.
# Both sides ship with it empty, which accepts any request; that is fine while
# the server listens on 127.0.0.1, but set a token if you bind to the LAN.
X4_TOKEN=

# ntfy (https://ntfy.sh or your own instance)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Gotify (self-hosted, https://gotify.net). Leave GOTIFY_URL empty to disable.
# The token is an application token created in the Gotify web UI.
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
