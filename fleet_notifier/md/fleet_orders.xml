<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Fleet_Order_Notifier" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <!--
      Legacy shell. Earlier versions kept the fleet roster and the order
      listener under this cue. It stays in place, empty, because MD refuses to
      remove a parent cue that still owns children in an existing savegame:
      with the parent present, the old children are dropped cleanly.
    -->
    <cue name="FleetNotifier_TrackFleet" namespace="this" />

    <!--
      Watches the current order of every player ship and reports an order the
      moment it stops being the current one, which is what "the order
      finished" looks like from outside the AI script.

      Polling is deliberate. event_object_order_finished needs a source group,
      and a group held in a cue variable is not rebuilt when the cue that
      created it is already completed in the savegame; the listener then ends
      up subscribed to nothing. This cue only reads live ship state, so it is
      unaffected by what the savegame remembers.

      Filters, so default behaviour does not spam:
        - the previous order was not the ship's default order (AutoTrade,
          Patrol, ... keep running and changing name),
        - the previous order was not temporary (the engine's own Undock and
          similar orders that appear for a moment when a new order starts).
    -->
    <cue name="FleetNotifier_Watch" namespace="this">
      <delay exact="3s" />
      <actions>
        <find_ship name="$Ships" space="player.galaxy" owner="faction.player" multiple="true" />

        <!-- First run in a session: nothing seen yet, so nothing is reported. -->
        <do_if value="not $SeenIds?">
          <set_value name="$SeenIds" exact="table[]" />
          <set_value name="$SeenNames" exact="table[]" />
          <set_value name="$SeenTemporary" exact="table[]" />
          <debug_text text="'FleetNotifier: watcher started, %s ships'.[$Ships.count]" />
        </do_if>

        <do_for_each name="$Ship" in="$Ships">
          <set_value name="$DefaultId" exact="'none'" />
          <do_if value="$Ship.defaultorder">
            <do_if value="$Ship.defaultorder.id">
              <set_value name="$DefaultId" exact="$Ship.defaultorder.id" />
            </do_if>
          </do_if>

          <!--
            Never store null: the order of an idle ship can report a null id
            or name, and MD treats null != null as true, which compared as
            "the order changed" on every pass.
          -->
          <set_value name="$OrderId" exact="'none'" />
          <set_value name="$OrderName" exact="'none'" />
          <set_value name="$OrderTemporary" exact="false" />
          <do_if value="$Ship.order">
            <do_if value="$Ship.order.id">
              <set_value name="$OrderId" exact="$Ship.order.id" />
              <set_value name="$OrderName" exact="$Ship.order.id" />
              <do_if value="$Ship.order.name">
                <set_value name="$OrderName" exact="$Ship.order.name" />
              </do_if>
              <set_value name="$OrderTemporary" exact="$Ship.order.istemporary" />
            </do_if>
          </do_if>

          <!--
            Table keys: a plain string key must start with '$' in MD, so an
            idcode like 'AIX-262' is rejected as a key. Keying on the ship
            component works and is what vanilla scripts do, e.g.
            $AttackingShipMarineTierAmounts.{$ship}.
          -->
          <do_if value="$SeenIds.{$Ship}?">
            <set_value name="$PreviousId" exact="$SeenIds.{$Ship}" />
            <set_value name="$PreviousName" exact="$SeenNames.{$Ship}" />
            <set_value name="$PreviousTemporary" exact="$SeenTemporary.{$Ship}" />

            <do_if value="$PreviousId != 'none' and $PreviousId != $DefaultId and not $PreviousTemporary">
              <!--
                Report only when the ship went back to idle (no order) or to
                its default order: that is the moment the order really ended.
                A queued follow-up order means the finished one was not last.
              -->
              <do_if value="$OrderId == 'none' or $OrderId == $DefaultId">
                <set_value name="$ShipName" exact="$Ship.knownname" />

                <set_value name="$SectorName" exact="'Unknown sector'" />
                <do_if value="$Ship.sector">
                  <set_value name="$SectorName" exact="$Ship.sector.knownname" />
                </do_if>

                <set_value name="$Payload" exact="'%s|%s|%s|%s'.[$Ship.idcode, $ShipName, $PreviousName, $SectorName]" />

                <debug_text text="'FleetNotifier: %s'.[$Payload]" chance="100" />
                <raise_lua_event name="'FleetNotifier.OrderFinished'" param="$Payload" />
              </do_if>
            </do_if>
          </do_if>

          <set_value name="$SeenIds.{$Ship}" exact="$OrderId" />
          <set_value name="$SeenNames.{$Ship}" exact="$OrderName" />
          <set_value name="$SeenTemporary.{$Ship}" exact="$OrderTemporary" />
        </do_for_each>

        <reset_cue cue="FleetNotifier_Watch" />
      </actions>
    </cue>

    <!-- Reports every game load, so debuglog shows the script is alive. -->
    <cue name="FleetNotifier_Boot" instantiate="true">
      <conditions>
        <event_game_loaded />
      </conditions>
      <actions>
        <raise_lua_event name="'FleetNotifier.Ping'" param="'game_loaded'" />
      </actions>
    </cue>

  </cues>
</mdscript>
