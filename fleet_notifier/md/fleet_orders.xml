<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Fleet_Order_Notifier" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <!--
      Legacy shell. Earlier versions kept the fleet roster and the order
      listener under this cue. It stays in place, empty, because MD refuses to
      remove a parent cue that still owns children in an existing savegame.
    -->
    <cue name="FleetNotifier_TrackFleet" namespace="this" />

    <!--
      Watches every player ship and reports every order that stops being the
      ship's current order: finished, cancelled or replaced by another order,
      automatic ones included.

      The comparison is on the order object, not on its id or name, so three
      identical queued orders are three separate events.

      Polling is deliberate. event_object_order_finished needs a source group,
      and a group held in a cue variable is not rebuilt when the cue that
      created it is already completed in the savegame.

      Only one case is silent: a ship that had no order at all, because there
      is nothing to report.
    -->
    <cue name="FleetNotifier_Watch" namespace="this">
      <delay exact="3s" />
      <actions>
        <find_ship name="$Ships" space="player.galaxy" owner="faction.player" multiple="true" />

        <!--
          State lives in the script's static namespace (md.$...) because a cue
          that resets itself drops its own namespace variables.
        -->
        <do_if value="not md.$SeenOrder?">
          <set_value name="md.$SeenOrder" exact="table[]" />
          <set_value name="md.$SeenIds" exact="table[]" />
          <set_value name="md.$SeenNames" exact="table[]" />
          <debug_text text="'FleetNotifier: watcher started, %s ships'.[$Ships.count]" />
        </do_if>

        <!-- Separate guard so an existing save without the busy table migrates
             without losing the seen-order state. -->
        <do_if value="not md.$WasBusy?">
          <set_value name="md.$WasBusy" exact="table[]" />
        </do_if>

        <do_for_each name="$Ship" in="$Ships">
          <set_value name="$CurrentOrder" exact="$Ship.order" />
          <set_value name="$ShipName" exact="$Ship.knownname" />

          <!--
            Never store null: null != null is true in MD, which made every
            sample look like a change. Ids and names are strings, with 'none'
            standing in for "no order".
          -->
          <set_value name="$OrderId" exact="'none'" />
          <set_value name="$OrderName" exact="'none'" />
          <do_if value="$CurrentOrder">
            <do_if value="$CurrentOrder.id">
              <set_value name="$OrderId" exact="$CurrentOrder.id" />
              <set_value name="$OrderName" exact="$OrderId" />
              <do_if value="$CurrentOrder.name">
                <set_value name="$OrderName" exact="$CurrentOrder.name" />
              </do_if>
            </do_if>
          </do_if>

          <!--
            Activities in the queue. ship.orders holds the whole queue with the
            default order as its first entry, so the default order is skipped
            and everything else counts, including the order currently running.
          -->
          <set_value name="$Active" exact="0" />
          <do_if value="$Ship.orders">
            <do_for_each name="$QueuedOrder" in="$Ship.orders">
              <do_if value="$QueuedOrder != $Ship.defaultorder">
                <set_value name="$Active" operation="add" exact="1" />
              </do_if>
            </do_for_each>
          </do_if>

          <set_value name="$IsBusy" exact="false" />
          <do_if value="$Active gt 0">
            <set_value name="$IsBusy" exact="true" />
          </do_if>

          <!--
            Pilot name for the role-play phrasing. Left empty when the ship has
            no pilot; the server then falls back to the ship name.
          -->
          <set_value name="$Captain" exact="''" />
          <do_if value="$Ship.pilot">
            <do_if value="$Ship.pilot.name">
              <set_value name="$Captain" exact="$Ship.pilot.name" />
            </do_if>
          </do_if>

          <!--
            Table keys: a plain string key must start with '$' in MD, so an
            idcode like 'AIX-262' is rejected as a key. Keying on the ship
            component works and is what vanilla scripts do, e.g.
            $AttackingShipMarineTierAmounts.{$ship}.
          -->
          <do_if value="md.$SeenOrder.{$Ship}?">
            <set_value name="$PreviousOrder" exact="md.$SeenOrder.{$Ship}" />
            <set_value name="$PreviousId" exact="md.$SeenIds.{$Ship}" />
            <set_value name="$PreviousName" exact="md.$SeenNames.{$Ship}" />

            <do_if value="$PreviousId != 'none' and $PreviousOrder != $CurrentOrder">
              <set_value name="$SectorName" exact="'Unknown sector'" />
              <do_if value="$Ship.sector">
                <set_value name="$SectorName" exact="$Ship.sector.knownname" />
              </do_if>

              <set_value name="$Payload" exact="'%s|%s|%s|%s|%s'.[$Ship.idcode, $ShipName, $PreviousName, $SectorName, $Captain]" />

              <debug_text text="'FleetNotifier: %s'.[$Payload]" chance="100" />
              <raise_lua_event name="'FleetNotifier.OrderFinished'" param="$Payload" />
            </do_if>
          </do_if>

          <!--
            Second event: the queue went from having activities to none. It is
            raised in the same pass as the last finished order, so the player
            gets both messages.
          -->
          <do_if value="md.$WasBusy.{$Ship}? and md.$WasBusy.{$Ship} and not $IsBusy">
            <set_value name="$IdlePayload" exact="'%s|%s|%s'.[$Ship.idcode, $ShipName, $Captain]" />

            <debug_text text="'FleetNotifier idle: %s'.[$IdlePayload]" chance="100" />
            <raise_lua_event name="'FleetNotifier.Idle'" param="$IdlePayload" />
          </do_if>

          <set_value name="md.$SeenOrder.{$Ship}" exact="$CurrentOrder" />
          <set_value name="md.$SeenIds.{$Ship}" exact="$OrderId" />
          <set_value name="md.$SeenNames.{$Ship}" exact="$OrderName" />
          <set_value name="md.$WasBusy.{$Ship}" exact="$IsBusy" />

          <debug_text text="'FleetNotifier sample: %s order=%s name=%s active=%s captain=%s'.[$Ship.idcode, $OrderId, $OrderName, $Active, $Captain]" chance="100" />
        </do_for_each>

        <reset_cue cue="FleetNotifier_Watch" />
      </actions>
    </cue>

    <!-- Reports every game load, so debuglog shows the script is alive. -->
    <cue name="FleetNotifier_Boot" instantiate="true">
      <conditions>
        <event_game_loaded />
      </conditions>
      <actions>
        <raise_lua_event name="'FleetNotifier.Ping'" param="'game_loaded'" />
      </actions>
    </cue>

  </cues>
</mdscript>
